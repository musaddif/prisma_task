generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  email    String
  newsletter Boolean @default(false)

  // Delivery
  country     String @default("United States")
  firstName   String
  lastName    String
  address     String
  apartment   String
  city        String
  state       String
  postalCode  String

  // Payment — cardNumber is unique so the same card cannot be registered twice
  cardNumber String @unique
  expiryDate String
  cvv        String
  cardName   String

  // Billing
  sameBillingAddress Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}